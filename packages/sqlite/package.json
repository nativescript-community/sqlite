{
    "name": "@nativescript-community/sqlite",
    "version": "3.5.9",
    "description": "SQLite for NativeScript, everything included: native threads, Node-API and JNI / Objective-C bindings, a default SQLite on each platform. Pick the smaller packages (sqlite-core, sqlite-napi...) to bring your own.",
    "main": "index",
    "typings": "index.d.ts",
    "sideEffects": true,
    "scripts": {
        "build": "npm run tsc && npm run readme",
        "build.all": "npm run build",
        "readme": "readme generate -c ../../tools/readme/blueprint.json",
        "tsc": "tsc --build",
        "clean": "bin/rimraf ./*.js ./*.js.map ./*.d.ts ./*.tsbuildinfo ./typeorm ./nanosql"
    },
    "nativescript": {
        "platforms": {
            "android": "6.2.0",
            "ios": "6.2.0"
        }
    },
    "keywords": [
        "NativeScript",
        "JavaScript",
        "Android",
        "iOS"
    ],
    "author": {
        "name": "Martin Guillon",
        "email": "martin@akylas.fr"
    },
    "bugs": {
        "url": "https://github.com/nativescript-community/sqlite/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/nativescript-community/sqlite",
    "readmeFilename": "README.md",
    "repository": "nativescript-community/sqlite",
    "peerDependencies": {
        "@nativescript/core": "*"
    },
    "dependencies": {
        "@nativescript-community/sqlite-bridge": "3.5.9",
        "@nativescript-community/sqlite-core": "3.5.9",
        "@nativescript-community/sqlite-default-engine": "3.5.9",
        "@nativescript-community/sqlite-napi": "3.5.9"
    },
    "files": [
        "platforms",
        "**/*.js",
        "**/*.d.ts",
        "**/*.mjs"
    ]
}
