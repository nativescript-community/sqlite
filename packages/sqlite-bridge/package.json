{
    "name": "@nativescript-community/sqlite-bridge",
    "version": "4.1.2",
    "description": "JNI and Objective-C bridges of @nativescript-community/sqlite-core, for NativeScript runtimes without Node-API (NativeScript 8 and older).",
    "sideEffects": false,
    "scripts": {
        "prepack": "test -d platforms/ios/NSSqliteBridge.xcframework || (echo 'prepack: NSSqliteBridge.xcframework missing, run native/build-ios.sh (macOS) before publishing' >&2; exit 1)",
        "build": "npm run tsc && npm run readme",
        "readme": "readme generate -c ../../tools/readme/blueprint.json",
        "build.all": "npm run build",
        "tsc": "cpy '**/*.d.ts' '../../packages/sqlite-bridge' --parents --cwd=../../src/sqlite-bridge && tsc  --build",
        "clean": "bin/rimraf ./*.d.ts ./*.js ./*.js.map ./*.tsbuildinfo ./*.mjs ./*.mjs.map ./angular ./svelte ./vue* ./react"
    },
    "nativescript": {
        "platforms": {
            "android": "8.0.0",
            "ios": "8.0.0"
        }
    },
    "keywords": [
        "NativeScript",
        "SQLite",
        "Android",
        "iOS"
    ],
    "author": {
        "name": "Martin Guillon",
        "email": "martin@akylas.fr"
    },
    "bugs": {
        "url": "https://github.com/nativescript-community/sqlite/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/nativescript-community/sqlite",
    "repository": "nativescript-community/sqlite",
    "readmeFilename": "README.md",
    "dependencies": {
        "@nativescript-community/sqlite-core": "^4.1.2"
    },
    "files": [
        "platforms"
    ],
    "publishConfig": {
        "access": "public"
    }
}
