{
    "name": "@nativescript-community/sqlite-bridge",
    "version": "3.5.9",
    "description": "JNI and Objective-C bridges of @nativescript-community/sqlite-core, for NativeScript runtimes without Node-API (NativeScript 8 and older).",
    "sideEffects": false,
    "scripts": {
        "build": "npm run readme",
        "readme": "readme generate -c ../../tools/readme/blueprint.json"
    },
    "nativescript": {
        "platforms": {
            "android": "8.0.0",
            "ios": "8.0.0"
        }
    },
    "keywords": [
        "NativeScript",
        "SQLite",
        "Android",
        "iOS"
    ],
    "author": {
        "name": "Martin Guillon",
        "email": "martin@akylas.fr"
    },
    "bugs": {
        "url": "https://github.com/nativescript-community/sqlite/issues"
    },
    "license": "Apache-2.0",
    "homepage": "https://github.com/nativescript-community/sqlite",
    "repository": "nativescript-community/sqlite",
    "readmeFilename": "README.md",
    "dependencies": {
        "@nativescript-community/sqlite-core": "3.5.9"
    },
    "files": [
        "platforms"
    ],
    "publishConfig": {
        "access": "public"
    }
}
